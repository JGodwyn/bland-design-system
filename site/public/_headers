# Cloudflare Pages headers for the public site (npm run site:build copies this into dist-site/; landing audit
# 2026-11-10). No full Content-Security-Policy yet: React's inline style attributes would need style-src
# 'unsafe-inline', so it waits until the page's outside links and scripts are final.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Vite's hashed files never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/docs/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The agent manifest is read by agents and registries on other origins.
/.well-known/ard.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
