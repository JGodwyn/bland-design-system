{
  "name": "bland-ui",
  "version": "0.1.0",
  "description": "Bland design system: tokens and React components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JGodwyn/bland-design-system.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./base.css": "./dist/base.css",
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:checksum": "tsx scripts/figma/checksum.ts",
    "build": "npm run tokens && vite build && cp src/tokens/tokens.css src/styles/fonts.css src/styles/base.css dist/ && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "tsx scripts/release/package-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/components/**/*.css\" --allow-empty-input",
    "test:lint": "node --test scripts/stylelint/*.test.js",
    "audit": "npm audit --omit=dev",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "props": "tsx scripts/build-props.ts",
    "docs": "npm run props && vite --config playground/vite.config.ts",
    "docs:phone": "npm run props && vite --config playground/vite.config.ts --host",
    "docs:build": "npm run props && vite build --config playground/vite.config.ts",
    "docs:preview": "vite preview --config playground/vite.config.ts",
    "site:build": "npm run docs:build && rm -rf dist-site && mkdir -p dist-site && cp -R dist-docs dist-site/docs && cp site/_redirects dist-site/",
    "docs:stop": "lsof -t -iTCP:5180 -sTCP:LISTEN | xargs kill 2>/dev/null; echo \"Port 5180 is free.\"",
    "tokens:drift": "tsx scripts/drift.ts",
    "test:drift": "tsx --test scripts/tokens/drift.test.ts",
    "brand": "tsx scripts/brand.ts",
    "test:brand": "tsx --test scripts/brand/brand.test.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss-value-parser": "4.2.0",
    "react": "^19.3.1",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "^19.3.1",
    "stylelint": "17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@internationalized/date": "3.12.4",
    "react-aria": "3.52.1",
    "react-stately": "3.50.0"
  }
}
